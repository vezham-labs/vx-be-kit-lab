{
  "name": "tamizhi-core-go",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tamizhi/core",
  "projectType": "library",
  "tags": ["language:go"],
  "implicitDependencies": ["tamizhi-contracts-go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go build ./packages/tamizhi/core/..."
      },
      "outputs": [],
      "inputs": ["production", "^production", "goGlobals"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go test -race -count=1 ./packages/tamizhi/core/..."
      },
      "inputs": [
        "default",
        "^default",
        {
          "env": "TAMIZHI_TEST_POSTGRES_URL"
        },
        "goGlobals"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go vet ./packages/tamizhi/core/..."
      },
      "inputs": ["default", "^default", "goGlobals"]
    },
    "browser-fixture": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "scripts/go test -run TestBrowserFixtureServer -count=1 -timeout=15m ./packages/tamizhi/core/...",
        "env": {
          "TAMIZHI_BROWSER_FIXTURE": "1"
        }
      }
    }
  }
}
