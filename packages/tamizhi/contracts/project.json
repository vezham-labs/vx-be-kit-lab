{
  "name": "tamizhi-contracts-go",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tamizhi/contracts",
  "projectType": "library",
  "tags": ["language:go"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go build ./packages/tamizhi/contracts/..."
      },
      "outputs": [],
      "inputs": ["production", "^production", "goGlobals"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go test -race -count=1 ./packages/tamizhi/contracts/... ./tools/contracts/..."
      },
      "inputs": [
        "default",
        "^default",
        "goGlobals",
        "{workspaceRoot}/tools/contracts/**/*.go"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go vet ./packages/tamizhi/contracts/... ./tools/contracts/..."
      },
      "inputs": [
        "default",
        "^default",
        "goGlobals",
        "{workspaceRoot}/tools/contracts/**/*.go"
      ]
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go run ./tools/contracts"
      }
    },
    "check-contracts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/go run ./tools/contracts -check"
      }
    }
  }
}
